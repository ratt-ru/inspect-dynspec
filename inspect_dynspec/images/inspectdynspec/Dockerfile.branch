FROM kernsuite/base:10

# Install Python 3, pip, python-is-python3 (for the `python` alias), and required tools
# We also install python3-wheel and python3-setuptools via apt to avoid pip upgrade conflicts
RUN apt-get update && apt-get install -y \
    software-properties-common \
    wget \
    git \
    python3 \
    python3-pip \
    python3-wheel \
    python3-setuptools \
    python-is-python3 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN python -mpip install --no-cache-dir --break-system-packages "git+https://github.com/ratt-ru/inspect-dynspec"

CMD {CMD}